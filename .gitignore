```gitignore
# Compiled and binary files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.swp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Build directories
dist/
build/
target/

# Python specific
*.pyo
*.pyd
*.so
*.egg-info/

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# OS generated files
.DS_Store
Thumbs.db
```